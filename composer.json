{
  "name": "laravie/dhosa",
  "description": "Hot Swapping for Laravel Eloquent",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Mior Muhammad Zaki",
      "email": "crynobone@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Laravie\\Dhosa\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Laravie\\Dhosa\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.1 || ^8.2",
    "illuminate/database": "^9.0 || ^10.0"
  },
  "require-dev": {
    "laravel/legacy-factories": "^1.0.4",
    "orchestra/testbench": "^8.0"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev"
}
